DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # API and deployment health-check endpoints must retain explicit PHP
    # filenames: API requests can use POST/PUT, which must never be redirected.
    RewriteRule ^api/ - [END]
    RewriteRule ^healthz\.php$ - [END]

    # Recover any browser-cached URL generated by the earlier faulty rule.
    RewriteRule ^var/www/html/(.+)$ /$1 [R=302,L,NE]

    # Canonical public pages use extensionless URLs. Capture the browser's
    # original request path so the redirect never resolves to a filesystem
    # directory (such as /var/www/html on Render).
    RewriteCond %{HTTP_HOST} ^erni-pms\.onrender\.com(?::\d+)?$ [NC]
    RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.php(?:[?\s]) [NC]
    RewriteRule ^ https://erni-pms.onrender.com/%1 [R=301,L,NE]

    RewriteCond %{HTTP_HOST} !^erni-pms\.onrender\.com(?::\d+)?$ [NC]
    RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.php(?:[?\s]) [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # Serve an extensionless page from its PHP implementation. THE_REQUEST
    # remains extensionless after this internal rewrite, so the redirect above
    # cannot loop.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [END]

    # Redirect to HTTPS outside local development hosts
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?$ [NC]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Set proper headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Disable directory listing
Options -Indexes

# Allow access to public files
<FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public"
</FilesMatch>
